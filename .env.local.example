# Local environment for Markaestro.
#
# Generated from apphosting.yaml by `npm run env:example`. Do not edit by
# hand: a variable added to the deployment appears here on the next run,
# and CI fails when this file and apphosting.yaml disagree.
#
# Copy to .env.local and fill in what you need. Values shown are the
# production defaults for public configuration; every secret is blank,
# because secrets live in Secret Manager and never in the repository.
#
# You do NOT need every variable. The first section is what the app needs
# to boot; everything after it unlocks one integration at a time, so you
# can work on the composer without registering six OAuth apps.

# ── Required to boot ─────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=markaestro.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=markaestro-0226220726
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=markaestro-0226220726.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=227206788749
NEXT_PUBLIC_FIREBASE_APP_ID=1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4
NEXT_PUBLIC_APP_URL=https://markaestro.com
# Any long random string locally. Encrypts stored OAuth tokens.
ENCRYPTION_KEY=
# The whole service account JSON on one line, or use `gcloud auth application-default login` instead and leave this empty.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Optional: integrations, billing, and tuning ──────────────────────────

NEXT_PUBLIC_DIRECT_MEDIA_UPLOADS_ENABLED=1
OAUTH_BASE_URL=https://markaestro.com
NEXT_PUBLIC_APP_ORIGIN=https://app.markaestro.com
NEXT_PUBLIC_MARKETING_URL=https://markaestro.com
APP_DOMAIN_SPLIT_ENABLED=1
TIKTOK_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/tiktok
TIKTOK_ADS_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/tiktok_ads
INSTAGRAM_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/instagram
META_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/meta
THREADS_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/threads
PINTEREST_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/pinterest
PINTEREST_API_ENVIRONMENT=production
LINKEDIN_OAUTH_REDIRECT_URI=https://markaestro.com/api/oauth/callback/linkedin
LINKEDIN_API_VERSION=202608
META_READ_USER_CONTENT_ENABLED=0
LINKEDIN_MEMBER_ANALYTICS_ENABLED=0
SOCIAL_INTELLIGENCE_DEFAULT_STAGE=off
# Leave empty to disable the AI features rather than to break them.
VERTEX_AI_PROJECT=markaestro-0226220726
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_FAST_MODEL=gemini-2.5-flash
VERTEX_AI_STRATEGIST_MODEL=gemini-2.5-pro
WORKER_DUE_QUEUE_ENABLED=1
WORKER_CLOUD_TASKS_ENABLED=1
WORKER_TASKS_QUEUE=markaestro-workspace-ticks
WORKER_TASKS_LOCATION=us-central1
WORKER_TASKS_TARGET_ORIGIN=https://markaestro--markaestro-0226220726.us-central1.hosted.app
WORKER_LEGACY_SWEEP_INTERVAL_MS=3600000
WORKER_GLOBAL_PHASE_INTERVAL_MS=900000
MAX_WEBHOOK_ENDPOINTS_PER_WORKSPACE=25
STRIPE_PRICE_STARTER_MONTHLY=price_1TFpVrJUPkOCaFhqipVPE5Yj
STRIPE_PRICE_STARTER_ANNUAL=price_1TFpVsJUPkOCaFhqwKHHhVxV
STRIPE_PRICE_PRO_MONTHLY=price_1TKF0dJUPkOCaFhqF0Tx9L4h
STRIPE_PRICE_PRO_ANNUAL=price_1TKF0eJUPkOCaFhquNkrVZ9x
STRIPE_PRICE_BUSINESS_MONTHLY=price_1TFpVtJUPkOCaFhqLRfEpTWH
STRIPE_PRICE_BUSINESS_ANNUAL=price_1TKF0fJUPkOCaFhqfUPfC8n4
STRIPE_PRICE_ADDON_BRAND_MONTHLY=price_1U5keVJUPkOCaFhqlfPaerjV
STRIPE_PRICE_ADDON_BRAND_ANNUAL=price_1U5keWJUPkOCaFhqGRbqFH7S
STRIPE_PRICE_ADDON_SEAT_MONTHLY=price_1U5keWJUPkOCaFhqQcvWO7Ui
STRIPE_PRICE_ADDON_SEAT_ANNUAL=price_1U5keXJUPkOCaFhqE7XGiNY7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Shared secret the scheduler sends to /api/worker/*. Any string locally.
WORKER_SECRET=
RESEND_API_KEY=
# Sender address for transactional email. Sends are skipped locally when RESEND_API_KEY is empty.
RESEND_FROM=Markaestro <no-reply@markaestro.com>
# Root secret that per-workspace conversion ingest keys are derived from.
CONVERSION_INGEST_SECRET=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_CLIENT_KEY=
TIKTOK_ADS_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
LINKEDIN_PROFILE_CLIENT_ID=
LINKEDIN_PROFILE_CLIENT_SECRET=
LINKEDIN_COMMUNITY_CLIENT_ID=
LINKEDIN_COMMUNITY_CLIENT_SECRET=
# Comma separated. Adds accounts to the Intelligence private preview without a deploy.
INTELLIGENCE_PREVIEW_EMAILS=
# Comma separated, as above but by uid.
INTELLIGENCE_PREVIEW_UIDS=
PUBLIC_API_AUTH_CACHE_TTL_MS=15000
