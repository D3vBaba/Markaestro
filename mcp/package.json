{
  "name": "@markaestro/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that lets AI agents schedule, publish, and review Markaestro posts through the public API",
  "license": "MIT",
  "type": "module",
  "bin": { "markaestro-mcp": "./dist/index.js" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": { "node": ">=20" }
}
