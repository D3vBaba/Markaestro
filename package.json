{
  "name": "markaestro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:queries": "node scripts/validate-firestore-queries.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "ci": "npm run lint && npm run typecheck && npm run validate:queries && npm run copy:check && npm run check:routes && npm run check:capabilities && npm run env:check && npm run openapi:check && npm run docs:check && npm run test",
    "stripe:sync-prices": "node scripts/sync-stripe-prices.mjs",
    "stripe:sync-prices:dry": "node scripts/sync-stripe-prices.mjs --dry-run",
    "slidesmith:schedule": "node --env-file=.env.local scripts/schedule-slidesmith-handoffs.mjs --apply",
    "openapi:generate": "node --import ./scripts/lib/ts-alias-loader.mjs scripts/generate-openapi.mjs",
    "openapi:check": "node --import ./scripts/lib/ts-alias-loader.mjs scripts/generate-openapi.mjs --check",
    "check:routes": "node scripts/check-route-contracts.mjs",
    "check:capabilities": "node --import ./scripts/lib/ts-alias-loader.mjs scripts/check-capability-parity.mjs",
    "env:example": "node scripts/generate-env-example.mjs",
    "env:check": "node scripts/generate-env-example.mjs --check",
    "docs:api": "node --import ./scripts/lib/ts-alias-loader.mjs scripts/generate-api-docs.mjs",
    "docs:check": "node --import ./scripts/lib/ts-alias-loader.mjs scripts/generate-api-docs.mjs --check"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/tasks": "^6.3.0",
    "@sentry/nextjs": "^10.42.0",
    "@swc/helpers": "^0.5.23",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.7.0",
    "next": "^16.2.1",
    "next-intl": "^4.13.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^21.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "react-day-picker": "^9.13.2",
    "recharts": "^3.7.0",
    "shadcn": "^3.8.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
