\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985480---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"6c3b8f184074ab5e94a3a369be46a6709bd5ba42","hash":"6c3b8f184074ab5e94a3a369be46a6709bd5ba42","commitMessage":"fix(meta): surface Pages that Facebook's grant no longer covers\n\nTwo brands' scheduled posts kept failing with \"…permission(s) must be\ngranted before impersonating a user's page\" while the UI showed them\nconnected. Probing Graph with the stored tokens showed why: the user\ntoken is valid and holds pages_manage_posts, but its granular scopes name\na single Page. Every other linked Page is outside the grant, so Graph\nrejects its Page token on every call.\n\nI had removed revocation from the reauthorization sync after reconnecting\none brand appeared to break the others. That reading was wrong: those\nPages really had lost access, and suppressing the signal turned a visible\nproblem into silent publish failures. Absence from a *fully enumerated*\ngrant is now recorded again — as `error` with a message naming the fix\n(\"Reconnect Facebook and tick this Page\"), not as an opaque revoke, and\nwithout deleting anything, so reconnecting and ticking the Page restores\nit. The grantIsComplete guard still prevents a partial read from ever\nmarking a healthy Page.\n\nPublishing now records the same failure when Graph reports the Page token\ncan no longer impersonate the Page, so a channel that cannot publish stops\nclaiming it can.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/6c3b8f184074ab5e94a3a369be46a6709bd5ba42","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T20:50:49Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/f6391cd1-e7d2-4619-9ba5-1eea2dc1e146?project=227206788749","createTime":"2026-08-08T20:50:52.996705962Z","updateTime":"2026-08-08T20:55:46.488448Z","displayName":"build-2026-08-08-007","uid":"66799034-9341-4c77-bb4b-da2aa01141b1","etag":"1Hpn-koDwS9ge1MN2l5DsGs2CfVEibUOMTkaT6uYefA","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-006","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-006","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN","value":"https://app.markaestro.com","availability":["BUILD","RU