arkaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1395856993---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"39ff33666442173aed8a085782d92e362870d75e","hash":"39ff33666442173aed8a085782d92e362870d75e","commitMessage":"feat(tiktok): add Direct Post publishing alongside the inbox hand-off\n\nPublishes straight to the creator's profile instead of handing content to\ntheir TikTok inbox to finish manually, so a post scheduled for 09:00\nactually goes live at 09:00.\n\nOpt-in per post and never a fallback: the adapter branches only on an\nexplicit `settings.postMode === 'direct_post'`, so absent or malformed\nsettings keep the existing inbox behaviour untouched.\n\nThe composer panel implements TikTok's Content Sharing Guidelines, which\nthe Content Posting API audit checks against — a rejection there is what\nprompted this. Every control is driven by a live creator_info query:\nnickname and avatar shown, privacy dropdown with no default value and\noptions taken from privacy_level_options, interaction toggles unchecked\nby default and greyed out when the account disables them, Duet/Stitch\nomitted for photo posts, commercial disclosure off by default with the\nrequired \"Your brand\" / \"Branded content\" labels, \"Only me\" disabled\nwhile branded content is selected, publish blocked until every required\nchoice is made, and the exact compliance declaration above the button.\nThe form resets after each post so a carried-over privacy level cannot\nbecome a de facto default.\n\nRules are enforced server-side too, against creator_info re-queried at\npublish time — a scheduled post can sit for days while the creator\nchanges their account settings, and an API caller must not be able to\nbypass what the UI requires.\n\nLow-level upload primitives move to tiktok-media.ts so both flows share\nthem; that extraction is a pure move.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/39ff33666442173aed8a085782d92e362870d75e","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-14T09:49:20Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/df8c77ed-27c3-4677-a73f-3f632cb7250c?project=227206788749","createTime":"2026-08-14T09:49:50.392976170Z","updateTime":"2026-08-14T09:56:15.068523Z","displayName":"build-2026-08-14-001","uid":"7fef62a1-6777-4f17-aba5-bb53f32d5e97","etag":"qv9uIBmU5UPUXqj0X_wj8KPBtkBP3GAXU76Y72y7UQ8","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-14-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-14-002","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_