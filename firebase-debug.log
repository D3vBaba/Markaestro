,"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_APP_ID","secret":"projects/227206788749/secrets/TIKTOK_ADS_APP_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_KEY","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_KEY/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_SECRET","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"d55ad63148dfb4d0d53c6edd10ae0ff6be43a70d","hash":"d55ad63148dfb4d0d53c6edd10ae0ff6be43a70d","commitMessage":"Fix missing Firestore indexes breaking all API requests for d3vbaba@gmail.com\n\nRoot cause: `acceptPendingInvites` in `requireContext` fires a collection-group\nquery on `pendingInvites.email` on every request. No COLLECTION_GROUP index\nexisted for that field, so every API call threw FAILED_PRECONDITION (gRPC 9),\nleaving the user with a completely empty app.\n\nSecondary issue: `GET /api/campaigns` applied `.orderBy('createdAt')` before\n`.where('status', '==', ...)`, requiring a composite index that didn't exist.\n\nChanges:\n- firestore.indexes.json: add pendingInvites.email COLLECTION_GROUP field\n  override and campaigns [status, createdAt] composite index (deployed)\n- server-auth.ts: wrap acceptPendingInvites in try/catch — invite resolution\n  is non-fatal and must not block auth for the common path\n- campaigns/route.ts: remove orderBy when a status filter is present; sort\n  in JS instead (matches existing pattern in /api/posts)\n- workspaces/route.ts: add defensive fallbacks for collection-group queries\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/d55ad63148dfb4d0d53c6edd10ae0ff6be43a70d","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-06T16:45:12Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/a3c1d541-4f32-4842-99a1-d4c6ae6997b5?project=227206788749","createTime":"2026-04-06T16:45:18.802864980Z","updateTime":"2026-04-06T16:50:02.279260Z","displayName":"build-2026-04-06-001","uid":"76611112-ad96-465f-bad6-c63094c71294","etag":"mJA2yEVea17d0-Tksy2jY6oGo02SBcy2RhFPaF8bAAw","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-06-003","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-06-003","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasesto