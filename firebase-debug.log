,{"variable":"LINKEDIN_COMMUNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-3342152112---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"b406b50e8ce5341b469d1b66f13cb1136c4a9042","hash":"b406b50e8ce5341b469d1b66f13cb1136c4a9042","commitMessage":"Mobile-first responsive pass + intentional On Platform empty states\n\nShell & primitives:\n- Bottom tab bar on phones (Home/Analytics/Products/Posts/Calendar) with safe-area padding\n- h-screen -> h-dvh throughout the shell; viewport-fit=cover + theme colors\n- Dialogs: edge margins, max-height + internal scroll, stacked footers, 36px close targets\n- Sheets: full-width on phones; size=sm buttons 40px tall on touch, 32px on desktop\n- Global 16px form font on touch devices (kills iOS focus zoom); tap-highlight/overscroll cleanup\n\nPer-page fixes (360-430px and 320px sweeps):\n- Calendar: agenda rows show caption+time, filter chips scroll strip, bottom sheet scroll fix + safe area, 40px nav buttons\n- Analytics: heatmap scroll container, table min-widths, filter/select sizing, wrapping action rows\n- Content: pill touch targets, schedule sheet pinned footer, media remove buttons\n- Products: card min-height, always-visible delete on touch, detail sheet phone gutters + wrapping rows, wizard stacking scan row + 40px controls\n- Settings: compare-plans stacks, scrollable tab bar (fixed no-scrollbar typo), wrapping section headers, integration rows wrap at 320px\n- Onboarding/login/banners: wrapping OTP rows, paywall CTA fits 320px, banner touch targets\n\nOn Platform tab:\n- Per-reason states: not-connected/expired get a Connect/Reconnect CTA deep-linking to the product's Channels sheet (/products?open=<id>&section=channels); LinkedIn partner-API 403 presented as a capability note; transient errors keep Try again with the raw message demoted to fine print; zero posts gets a real empty state\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/b406b50e8ce5341b469d1b66f13cb1136c4a9042","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-07-10T06:08:22Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/1cdddfd4-e0bc-4548-8929-282d0a0bb43a?project=227206788749","createTime":"2026-07-10T06:08:25.136057915Z","updateTime":"2026-07-10T06:14:09.284901Z","displayName":"build-2026-07-10-001","uid":"7c8f4e75-39e2-4f28-9003-de7d151a4aa7","etag":"RzSqZD9ViZK7tk9LWFZcJN6lh3L9FUMnOsjBMZt_VGk","reconciling":false},{"name":"projects/markaestro-02262207