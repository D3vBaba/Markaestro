:"PINTEREST_CLIENT_SECRET","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_PROFILE_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_PROFILE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_PROFILE_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_PROFILE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1257647258---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"22f9e847dcf3cb143f94745d47247c0e9b133a34","hash":"22f9e847dcf3cb143f94745d47247c0e9b133a34","commitMessage":"feat(api): list posts by brand, delete posts, and close brand-scoping holes\n\nQuery and delete, both on scopes existing keys already carry — no key\nneeds reissuing:\n\n- GET /api/public/v1/posts gains ?productId= so a caller can ask what is\n  scheduled for one brand (posts.read). productId was already on the\n  response, so callers can also just read it per post.\n- DELETE /api/public/v1/posts/:id removes a post (posts.write, not a new\n  posts.delete scope). Refuses with VALIDATION_POST_IS_PUBLISHING while a\n  run is in flight — deleting then would let the run publish anyway,\n  leaving a live post with no record. The scheduler selects posts by\n  status/scheduledAt, so a deleted post simply drops out of the sweep.\n  Deleting a published post does not retract the platform copy.\n\nBrand scoping was enforced inconsistently, so a brand-bound key could\nreach other brands:\n\n- getPublicPost never checked ctx.productId, so GET /posts/:id read any\n  brand's post and POST /posts/:id/publish published any brand's post.\n- GET /job-runs/:id had no check at all. A run has no brand of its own,\n  so it now resolves the post it acts on and scopes to that.\n- Mismatches report NOT_FOUND, not FORBIDDEN, so a key cannot probe for\n  ids outside its brand.\n\nBrand filtering also moves from an in-memory pass into the Firestore\nquery on both /public/v1/posts and /connect/v1/posts. Filtering after the\nfetch applied `limit` first, so a brand-bound key asking for 25 posts\ncould get 3 — or none — while more existed. Equality-only filters, so no\ncomposite index (validate:queries passes).\n\nBehaviour change: a brand-bound key that was reading or publishing across\nbrands now gets 404. That was a leak rather than a feature, but it will\nbreak any integration relying on it.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/22f9e847dcf3cb143f94745d47247c0e9b133a34","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-05T22:02:21Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/94f8256f-a613-4921-bcae-0e3d849a8690?project=227206788749","createTime":"2026-08-05T22:02:27.496599351Z","updateTime":"2026-08-05T22:06:20.283076Z","displayName":"build-2026-08-05-004","uid":"b8e0e361-92a2-4194-b764-cb50f97ddff3","etag":"Fq6hkv4wjfWFrv2m9MDC6f8yQv4n0o4-bz12-F6IZD8","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-05-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-05-005","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","va