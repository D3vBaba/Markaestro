cket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"af31867d15b00f3ee1d403e604674b0775e3065c","hash":"af31867d15b00f3ee1d403e604674b0775e3065c","commitMessage":"fix: remove composition/subjectFocus from visual intent section sent to Gemini\n\nThe prior two fixes addressed the scene brief label and added ❌/✅\nexamples to the GPT prompt, but both missed the actual failure path:\nsection 3 of buildSlideshowImagePrompt() passed `visualIntent.composition`\nand `visualIntent.subjectFocus` to Gemini labeled \"every field is a\nconstraint, not a preference\". When GPT-4o-mini wrote those fields with\nvalues like \"frontal medium shot\" or \"woman facing camera\", Gemini\nobeyed them — overriding the camera angle rules that came later.\n\nRoot cause: composition/framing fields from GPT appearing as hard\nconstraints before the camera angle rules, letting GPT overrule the\nimage generator's style system.\n\nFix:\n- image-generator.ts: Drop composition and subjectFocus from the visual\n  intent section entirely. Rename it \"SCENE ATMOSPHERE\" (lighting, color\n  mood, motion only). Move camera angle rules to section 3 (immediately\n  after the scene brief) and strengthen label to \"NON-NEGOTIABLE — pick\n  one, it overrides all other framing instructions\". Move environment\n  rules to section 4 (before any visual intent data).\n- generator.ts: Constrain visualIntent.composition to the 5 allowed\n  camera angles by name in the system prompt rules. Constrain\n  visualIntent.subjectFocus to action-verb descriptions with an explicit\n  ban on \"looking at camera\", \"facing camera\", and frontal posing variants.\n  Update the JSON schema example fields to match.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/af31867d15b00f3ee1d403e604674b0775e3065c","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-11T12:39:28Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/d0faf8ef-c54f-42d4-bdfe-2d71087e37d0?project=227206788749","createTime":"2026-04-11T12:39:34.725454852Z","updateTime":"2026-04-11T12:43:17.438632Z","displayName":"build-2026-04-11-008","uid":"d81fecce-273e-4ab5-bae9-77951829de0f","etag":"S35jZgEyqboYoEPC1rrHDBFWbcNsAMdmrdiJyh_elGQ","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-11-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-11-005","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC