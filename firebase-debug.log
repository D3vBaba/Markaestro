use\nTikTok's minimum is 540×960. Force the short side to 720 px during transcode\n(via lanczos-scaled scale filter that preserves aspect ratio and rounds to\neven dimensions for x264).\n\nAlso clear post.errorMessage when a republish kicks off, so the UI doesn't\nkeep showing the prior failure's text while the retry is in flight.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/6709a0ab0f0a3e9928b06366ee9fcd38b406b357","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-05-04T17:06:27Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/8b7675d9-422e-4b65-872a-4a31335c0a1f?project=227206788749","createTime":"2026-05-04T17:06:29.892793199Z","updateTime":"2026-05-04T17:12:14.098684Z","displayName":"build-2026-05-04-005","uid":"ced7c3ef-423b-4677-920b-8b31938cb26e","etag":"IACTC7daquq59F3OA-UxRVV8DXqua2srmLRLd3rCm3g","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-05-04-006","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-05-04-006","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID