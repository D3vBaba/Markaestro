ame":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-162723100---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"b3e1492f10e9be00c8c11fb248b89757260ef1bc","hash":"b3e1492f10e9be00c8c11fb248b89757260ef1bc","commitMessage":"feat(analytics): close the loop — metrics ingestion pipeline + /analytics dashboard\n\nPhase 1 of the growth-tool roadmap:\n\n- PlatformAdapter gains optional fetchMetrics()/fetchAudience(); implemented\n  for all 6 channels with honest nulls (a metric the platform doesn't expose\n  is null, never a fabricated zero). Views is the canonical count (Meta\n  deprecated the impressions family).\n- Worker tick polls published posts on a decaying schedule (1h → 30d) via\n  metricsNextPollAt, stores per-channel snapshots under\n  posts/{id}/metrics/{stage}, denormalizes latest onto the post, backfills\n  90 days on first run, and sweeps for fresh publishes. Auth failures drive\n  the existing connection status machine.\n- Daily follower snapshots per connected account (audienceSnapshots) and\n  precomputed per-day rollups (analyticsDaily) so the analytics API reads\n  ~90 small docs instead of scanning posts.\n- GET /api/analytics with server-side plan-window clamping (Starter 7d /\n  Pro 90d / Business unlimited) + Business-only CSV export (formula-injection\n  safe). Plan limits/gates added to plans.ts and the pricing comparison.\n- /analytics page: KPI cards with prior-period deltas + sparklines, labeled\n  engagement rate (engagements ÷ reach), rule-based insights with sample\n  sizes, metric-tab trend chart, follower growth, best-time heatmap in the\n  viewer's timezone, content-format comparison, channel table (click to\n  filter), sortable top-posts leaderboard, teaching empty states, and a\n  data-provenance footnote.\n- Firestore composite indexes for the poller and range queries.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/b3e1492f10e9be00c8c11fb248b89757260ef1bc","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-07-03T06:20:56Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/46f77d94-249c-436a-ada0-bd3c3ec27e1c?project=227206788749","createTime":"2026-07-03T06:20:59.191122414Z","updateTime":"2026-07-03T06:25:42.581374Z","displayName":"build-2026-07-03-001","uid":"c914460b-06d9-411b-bcb3-dd3b6d51644c","etag":"80uocrXJPvPEnObTrPsY8k2eoHa3l2ZicfHOBUDI3uM","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-07-03-003","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-07-03-003",