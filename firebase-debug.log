ASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985486---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"784dbd3e606f2fd31645d0719f74a60d46d44c50","hash":"784dbd3e606f2fd31645d0719f74a60d46d44c50","commitMessage":"feat(pinterest): route the integration through API Sandbox\n\nPinterest Trial apps cannot create Pins against the production API, so\nthe whole integration — OAuth token exchange, board reads, Pin writes,\nanalytics — has to run against API Sandbox until Standard access is\ngranted. The adapter hardcoded https://api.pinterest.com/v5, so there was\nno single place to switch.\n\nRoute every Pinterest call through getPinterestApiUrl(), which resolves\nthe origin from PINTEREST_API_ENVIRONMENT (default production, invalid\nvalues throw rather than silently falling back to production). App\nHosting sets it to sandbox; the CSP report-only connect-src allows the\nsandbox origin.\n\nSandbox and production tokens, boards, and Pins are not interchangeable,\nso validateConnection refuses a connection whose stored environment no\nlonger matches the configured one and asks for a reconnect, and video\nPins are rejected up front because Sandbox cannot create them.\n\nAlso request boards:write — Pinterest requires it when creating a Pin\neven on a board that already exists.\n\ndocs/PINTEREST_SETUP.md covers Trial setup, the demo recording Pinterest\nrequires for the Upgrade flow, and the production cutover.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/784dbd3e606f2fd31645d0719f74a60d46d44c50","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T18:11:47Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/9496e462-963a-4935-a91c-7067ab36b959?project=227206788749","createTime":"2026-08-08T18:11:54.583569607Z","updateTime":"2026-08-08T18:16:37.985261Z","displayName":"build-2026-08-08-001","uid":"50892f4a-bd87-46de-af47-d6b31abf752c","etag":"0l0jeWD9klIYF40X2KQX1L-68HPp9JK-XIE2Puo-xHo","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-04-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-04-001","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL