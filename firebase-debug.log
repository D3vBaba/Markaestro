FileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985481---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"a1840c3eea0614533afdf8e6d9cc15f668efa671","hash":"a1840c3eea0614533afdf8e6d9cc15f668efa671","commitMessage":"fix(meta): a failed Page preflight read must not block publishing\n\nRequeued Facebook posts got past destination resolution and then failed\non \"Facebook access error: Any of the pages_read_engagement,\npages_manage_metadata, … permission(s) must be granted\".\n\nThat error came from the Page Publishing Authorization preflight, which\ndoes GET /{pageId}?fields=id,name,tasks. Reading `tasks` requires\npages_read_engagement / pages_show_list; publishing to /{pageId}/feed\nrequires pages_manage_posts. They are different permissions, so a token\nthat cannot read the Page can still be perfectly able to post to it —\nbut the check mapped Graph error code 10 (permission denied) to\ncanPublish: false and aborted the publish before it was ever attempted.\n\nCode 10 now joins the existing inconclusive path the function already\ndocuments: log it and let the publish call return the authoritative\nerror. Code 190 (invalid or expired token) still fails fast, because\nnothing will publish with it.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/a1840c3eea0614533afdf8e6d9cc15f668efa671","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T20:30:07Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/51a14548-2452-4917-8f07-84b62c10fa0f?project=227206788749","createTime":"2026-08-08T20:30:09.689360592Z","updateTime":"2026-08-08T20:35:13.354015Z","displayName":"build-2026-08-08-006","uid":"1cd7e1aa-b105-40c6-b7cd-4f7a1c77ef43","etag":"uKYQsYEy__gsC0pIjGguOFbWlNjkC93KAEC6F--R1Ec","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-005","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJEC