","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_SECRET","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_ID","secret":"projects/227206788749/secrets/X_CLIENT_ID/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_SECRET","secret":"projects/227206788749/secrets/X_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"93d5556464173465227d88bc7b98481957c01e76","hash":"93d5556464173465227d88bc7b98481957c01e76","commitMessage":"feat(design): port Claude Design redesign (phases 1–3)\n\nPorts the Markaestro redesign from the Claude Design handoff into the\nlive Next.js app. Introduces an OKLCH token layer + solid channel palette\nin globals.css and remaps shadcn tokens onto it so every primitive tracks\nlight/dark, accent, and brand channels cohesively.\n\nPhase 1 — shell + tokens + Dashboard + Campaigns:\n- New mk/* primitives: Channel, Channels metadata, Delta, Status, Spark,\n  StackedArea, format helpers.\n- Sidebar flipped from dark chrome to light paper with mono section\n  eyebrows, workspace switcher, user tile + log-out action.\n- Header simplified to 60px chrome (search + avatar); AppShell grid at\n  232px sidebar; PageHeader typography 26px/-0.025em + 13.5px subtitle.\n- OverviewChart restyled solid-fill (no gradients); dashboard rebuilt\n  with 4 KPI tiles + hairline posts-by-channel list + right rail.\n- Campaigns list reworked as hairline cards with pillStyle status pills,\n  underline tabs with counts, and ChevronRight affordance.\n\nPhase 2 — remaining pages:\n- Heatmap primitive added to mk/*.\n- Products list + ProductCard restyled with mono category eyebrow and\n  mk-token status pills.\n- Content (Posts) page retitled with consistent ProductContextBar and\n  underline tabs.\n- Calendar swapped hardcoded channel hexes for --mk-ch-* tokens, status\n  dots use --mk-pos/accent/warn/neg, day-of-week row uses mono eyebrow.\n- Analytics bar chart + tooltip + ProductContextBar on tokens.\n- Settings tab bar switched to ink-underline style.\n- Campaign detail header aligned with PageHeader typography.\n\nPhase 3 — palette cohesion pass:\n- New pillStyle(tone) helper emitting color-mix against --mk-pos/neg/warn/\n  accent/ink so every semantic pill tracks theme + accent changes.\n- Full sweep across MetricCard, TrialBanner, ScanProgressStepper, Header,\n  CampaignDetail (stage tints via equal-L/C oklch, postStatus via tones),\n  StandardCampaignView, PostCard, ApprovalsTab, ChannelSelector,\n  ScheduleSheet, Analytics (priorities / platform badges / health dots),\n  Settings (usage meters, all status badges, destructive actions),\n  ProductCreateWizard, ProductDetailSheet.\n- Recharts in analytics updated to --mk-rule-soft grid + --mk-ink-* ticks.\n\nNo logic changes — API wiring, form flows, Firebase, and routing are\nuntouched. Tailwind pastel classes (bg-emerald-50 / bg-rose-50 / etc.)\nreplaced with Markaestro tokens across every page in the app shell.\n\nScope deliberately out: marketing/auth/onboarding/pricing pages and\ndeeper wizard step-form visuals.\n\nCo-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/93d5556464173465227d88bc7b98481957c01e76","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-23T07:00:24Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/a46ad80e-e4f9-443c-aa77-1835878c64af?project=227206788749","createTime":"2026-04-23T07:00:39.617208400Z","updateTime":"2026-04-23T07:04:32.451662Z","displayName":"build-2026-04-23-004","uid":"0ec11fcb-620b-434f-8309-8eac21c35c4f","etag":"r8z0pDKbF9YxXNY9RBKQts_TcG07J3T-dUsJVkXq5SE","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-23-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-23-005","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10,"minInstances":1},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://mark