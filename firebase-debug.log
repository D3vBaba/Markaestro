UNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985479---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"e44c055f65576b2c655d95031b939246dc6c4bcd","hash":"e44c055f65576b2c655d95031b939246dc6c4bcd","commitMessage":"feat: connection guide, dropped-Page warning, and TikTok hand-off emails\n\nThree gaps that all cost us posts today.\n\nA guide at /guides/channels, linked from the sidebar, leads with the\ndistinction that caused the outage: the platform dialog grants permission\nworkspace-wide and replaces the previous selection, while the Page a\nbrand posts to is routing chosen per brand. Per-platform steps and a\ntroubleshooting section map each error message we emit to its fix.\n\nReconnecting Facebook with fewer Pages ticked silently revokes the rest.\nThe callback now reports which Pages the new grant dropped, and Brands\nshows a persistent, dismissible warning naming them — a toast that fades\nis how this went unnoticed until scheduled posts failed.\n\nTikTok cannot publish on a creator's behalf: the API only drops the video\nin their inbox, and nothing told them to go and finish it. Reaching the\ninbox now emails workspace owners with the exact steps, via Resend and\nthe existing brand wrapper. Both the scheduled poll and the in-app\npublish reach the same transition, so every TikTok post is covered, and a\n`tiktokInboxEmailSentAt` stamp keeps a repeated poll from mailing twice.\nDelivery is best-effort — the video is already with TikTok, so a mail\nfailure must never change the post's outcome.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/e44c055f65576b2c655d95031b939246dc6c4bcd","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T22:45:23Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/ff42eee6-1392-4ec3-8f68-612f09ad19d6?project=227206788749","createTime":"2026-08-08T22:45:26.057220619Z","updateTime":"2026-08-08T22:50:09.362418Z","displayName":"build-2026-08-08-008","uid":"a0cd81e7-6053-4999-8220-ab846f045e1c","etag":"D--0DF8wQov4wCXIngUKbCG4Zqaq7ZB1KzQEjebYcgg","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-007","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-007","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC