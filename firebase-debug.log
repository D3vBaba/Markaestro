bce78c9ef9f13d7e70440b5789f848d","commitMessage":"fix(onboarding): treat active subscription as onboarded (client gate)\n\nAppShell gated app entry on useOnboardingStatus, which only checked for a\nproduct (/api/products) and ignored subscription state. Since the onboarding\nflow never creates a product (it ends at the Stripe checkout paywall), a\ncomped or paid account could never clear the gate and was bounced back to the\npaywall indefinitely.\n\nPoint the hook at /api/onboarding/status, which already defines completion as\nhasSubscriptionHistory || hasProducts — aligning the client with the server so\nan active subscription/entitlement counts as onboarded. Preserves fail-open\nbehavior on request errors.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/3eb671c6ebce78c9ef9f13d7e70440b5789f848d","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-06-17T03:45:52Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/5c45a744-fab0-4359-8701-9f81e4b36def?project=227206788749","createTime":"2026-06-17T03:45:55.430680268Z","updateTime":"2026-06-17T03:50:38.815877Z","displayName":"build-2026-06-17-007","uid":"2962bf54-c692-45d6-9f66-c79f23e4b6a0","etag":"kX7kJkPtFtQ9gw4r7gHtYu_QuYA2mDkLpMOZVnw10ZE","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-17-006","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-17-006","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBA