ects/227206788749/secrets/TIKTOK_ADS_CLIENT_KEY/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_SECRET","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"bedb12fbd4e8dc9e06c595a876ae521439f4fa8c","hash":"bedb12fbd4e8dc9e06c595a876ae521439f4fa8c","commitMessage":"Revamp TikTok slideshow generation to candid UGC lifestyle aesthetic\n\n- Drop image resolution to 1K (1024px) for 56% cost saving ($0.151 → $0.067/img)\n- Rewrite all 20 character model prompts: studio portraits → candid lifestyle scenes\n  (people outdoors, full body, natural environments, iPhone photo quality)\n- Update ANGLE_VARIANTS: 3/4 headshots → back view / side profile / candid seated\n- Rewrite buildSlideshowImagePrompt(): enforce behind-the-back and over-shoulder\n  angles, real-world environments, explicit top/bottom text overlay zones (20%/15%),\n  warm desaturated iPhone photo color grading, strict no-studio rules\n- Rewrite BASE_SYSTEM_PROMPT in generator.ts to lead with the UGC aesthetic brief\n- Update all 6 story format templates: first-person confessional tone, cliffhanger\n  progression between slides, short punchy 3-10 word headlines, emotional hooks,\n  specific CTA copy that converts (\"Link in bio\" beats \"Follow for more\")\n- Reseed all 60 character model images (20 models × 3 angles) with new prompts\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/bedb12fbd4e8dc9e06c595a876ae521439f4fa8c","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-11T09:16:30Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/175900b5-6a2a-44b0-960f-b619ba17fac5?project=227206788749","createTime":"2026-04-11T09:16:49.787749119Z","updateTime":"2026-04-11T09:20:32.388561Z","displayName":"build-2026-04-11-006","uid":"c8b93742-f106-44ef-8355-cd891ef8f91a","etag":"xbnQZH5OYy5l2sblZSSBEcj4vCdFathjI2x6T_BQj7A","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-11-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-11-001","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable"