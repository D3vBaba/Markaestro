nderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2306951665---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"df3d96006a2f3887c9501e5a49a7dcc736e5f5a0","hash":"df3d96006a2f3887c9501e5a49a7dcc736e5f5a0","commitMessage":"feat(workspaces): production-harden team membership, entitlements, and switching\n\nSecurity\n- Enforce billing.manage on Stripe checkout + portal (any member could\n  previously cancel/modify the owner's subscription); portal now opens the\n  workspace's own customer so account comps can't shadow it\n- Lapsed subscriptions no longer keep premium entitlements: new\n  effectiveTier()/isActiveSubscription() gate every tier read (usage,\n  team, workspaces, analytics, analytics export); webhook keeps the last\n  known tier instead of writing 'unknown'\n- Revoke a member's API clients on removal/leave and re-verify the key\n  owner's membership in public-API auth, so keys die with the membership\n- Admin-level invites now require the owner-only team.roles.manage\n  (admins could mint peer admins via invite)\n- products/scan requires products.write; live-platform post deletion\n  requires posts.publish; read routes consistently gate on dashboard.read\n\nMembership lifecycle\n- Explicit invite accept/decline (banner + /api/team/invites endpoints)\n  replaces silent auto-join on every authenticated request; invite email\n  copy updated across locales; emailVerified required to redeem\n- Leave workspace (POST /api/team/leave), ownership transfer\n  (POST /api/team/[uid]/transfer-ownership), and workspace deletion\n  (DELETE /api/workspaces/[id]) with Stripe cancellation + full cleanup\n- Invitees are no longer funneled into personal onboarding + paywall:\n  onboarding status reports pending invites and cross-workspace activity\n- Team settings: pending invites list with revoke/resend, role-change\n  select, transfer ownership, honest invite toast, seat math that counts\n  pending invites; workspaces tab gains leave + delete\n\nWorkspace switching\n- useApiQuery defaults to the ACTIVE workspace (reactive) instead of the\n  literal 'default', so reads finally follow the switcher like writes\n- Selection persisted in a cookie the server honors for workspace-blind\n  requests; deterministic default membership (owned first, then oldest)\n  replaces the unordered limit(1) coin flip\n- Subscription + onboarding state re-fetch on switch; hard-coded\n  workspaceId:\"default\" removed from OAuth connect flows; mobile sheet\n  gains a real switcher; FORBIDDEN_WORKSPACE resets the selection\n  gracefully; localStorage key namespaced per account\n\nEntitlements model\n- Account entitlements merge with the workspace plan as\n  max(active tiers) — a comp can no longer downgrade a member inside a\n  premium workspace; legacy uid-keyed member-scan fallback retired\n- Workspace-creation limit derives from plans the user OWNS, not the\n  currently scoped workspace; slugs hardened (valid, capped, create())\n- Public API media quota always enforced (legacy keys without ownerUid\n  no longer bypass it); usage endpoint reads platformConnections and\n  reports real member/workspace counts; email changes propagate to\n  member docs\n\nTests: entitlement resolution, RBAC matrix, workspace ids/slugs, invite\nexpiry (29 new). i18n: 39 new keys translated across all 10 locales.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/df3d96006a2f3887c9501e5a49a7dcc736e5f5a0","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-17T14:13:53Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/b5e9ec7e-3111-4bc7-ae56-b51a4470eb21?project=227206788749","createTime":"2026-08-17T14:38:57.766996593Z","updateTime":"2026-08-17T14:42:50.516606Z","displayName":"build-2026-08-17-002","uid":"3edea704-eb31-4389-9605-3275d698119d","etag":"gDwfVaJeupayZazypAE__RluNhGhuTRYv_Sb67tPxxM","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-17-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-17-001","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN","value":"https://app.markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_MARKETING_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"varia