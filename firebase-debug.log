() before a conditional\n.where() requires a composite Firestore index. When a filter is present, skip\norderBy and sort results in JS instead (matches posts and ad-campaigns pattern).\n\nAffected endpoints:\n- GET /api/products?status=... — was failing with FAILED_PRECONDITION\n- GET /api/events?type=...&campaignId=...&contactId=... — same\n- GET /api/ai/tiktok-trends?status=...&productId=... — same\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/4022f879f389537bb13165004e76dce4ee5e249e","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-06T16:52:25Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/8514124a-9b38-4b5f-b6d5-08af3c4c272a?project=227206788749","createTime":"2026-04-06T16:52:28.098884362Z","updateTime":"2026-04-06T16:56:51.373538Z","displayName":"build-2026-04-06-002","uid":"e1221f06-6ade-44da-8bc1-1ac4c8a1c8e3","etag":"RHrMsrJZHx82Vdf9NUw-NpLzFnpR8NXZC61BrDJq_bU","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-06-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-06-005","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["B