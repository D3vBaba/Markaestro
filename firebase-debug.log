SenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"e7c6e5b51e0e6f1e6df8b6b93d6a2ccb787be27f","hash":"e7c6e5b51e0e6f1e6df8b6b93d6a2ccb787be27f","commitMessage":"feat(linkedin): add LinkedIn as publishing channel\n\nWires LinkedIn into OAuth, platform adapters, scheduling, and UI so users\ncan connect a LinkedIn account per product and publish text + image posts\nvia the app UI and public API.\n\n- Add `linkedin` to social channels, integration/OAuth providers, and rate limits\n- OAuth 3-legged flow using `openid profile email w_member_social` scopes;\n  store Person URN from `/v2/userinfo` as authorUrn on the connection\n- Publishing adapter hits versioned `/rest/posts` (LinkedIn-Version 202604)\n  with register → PUT → poll → create for image uploads\n- Token refresh marks expired LinkedIn connections so UI can prompt reconnect\n  (default tier does not issue refresh tokens)\n- ChannelSelector + Products Edit + Settings copy updated for the new channel\n- apphosting.yaml + secrets loader wire LINKEDIN_CLIENT_ID / _SECRET and\n  LINKEDIN_OAUTH_REDIRECT_URI\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/e7c6e5b51e0e6f1e6df8b6b93d6a2ccb787be27f","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-16T10:07:20Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/29ba2bcd-02e0-456d-ae7d-1c84d78d4067?project=227206788749","createTime":"2026-04-16T10:07:25.900287982Z","updateTime":"2026-04-16T10:11:49.016783Z","displayName":"build-2026-04-16-007","uid":"2757b59a-a101-4574-8e93-9371cfdb3561","etag":"eV7fWK6AGqyaswJ5DZJ92tyygJ14h7D_IGeU1JjR-Q8","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1