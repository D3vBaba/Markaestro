,"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"GOOGLE_CLIENT_ID","secret":"projects/227206788749/secrets/GOOGLE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"GOOGLE_CLIENT_SECRET","secret":"projects/227206788749/secrets/GOOGLE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"GOOGLE_ADS_DEVELOPER_TOKEN","secret":"projects/227206788749/secrets/GOOGLE_ADS_DEVELOPER_TOKEN/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_CLIENT_KEY","secret":"projects/227206788749/secrets/TIKTOK_CLIENT_KEY/versions/5","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_CLIENT_SECRET","secret":"projects/227206788749/secrets/TIKTOK_CLIENT_SECRET/versions/4","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_APP_ID","secret":"projects/227206788749/secrets/TIKTOK_ADS_APP_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_KEY","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_KEY/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_SECRET","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"a24eca0b069777158cbf88ea85ff22092ea3aec7","hash":"a24eca0b069777158cbf88ea85ff22092ea3aec7","commitMessage":"Bulletproof Firestore queries — shared helper, validation script, CI gate\n\nProblem:\n  orderBy(A) + where(B == v) on different fields requires a composite index.\n  When these are written as conditional patterns in API routes, the index\n  requirement is invisible and easy to miss, causing FAILED_PRECONDITION in\n  production with zero data displayed.\n\nSolution:\n  1. src/lib/firestore-list-query.ts — executeListQuery() helper that enforces\n     the safe pattern at the call site: filters are applied first; orderBy is\n     only added when there are no filters (single-field auto-index sufficient);\n     results are always returned sorted (Firestore or JS depending on path).\n     New routes should use this instead of building queries by hand.\n\n  2. All five API list routes migrated to executeListQuery():\n       GET /api/campaigns, /api/products, /api/posts,\n       /api/events, /api/ai/tiktok-trends\n\n  3. scripts/validate-firestore-queries.mjs — exercises every distinct query\n     shape used in the codebase against the live Firestore project. Exits 1 if\n     any query returns FAILED_PRECONDITION (missing index). Run with:\n       npm run validate:queries\n\n  4. cloudbuild.yaml — validate:queries runs as the first step before the\n     Docker build, blocking deployment if any index is missing.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/a24eca0b069777158cbf88ea85ff22092ea3aec7","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-06T17:03:28Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/621f6f5e-edb4-4304-8eae-fa4a146580a5?project=227206788749","createTime":"2026-04-06T17:03:30.933791643Z","updateTime":"2026-04-06T17:07:54.134867Z","displayName":"build-2026-04-06-003","uid":"90eae191-3c97-48fa-8c5c-ceace05bce47","etag":"I0OzvVYwGqMgEGrA5oCVO4tV_zvCVD468GUlmm4gaLY","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-06-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-06-002","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"TIKTOK_OAUTH_REDIRECT_URI","value":"https://markaestro.com/api/oauth/callback/tiktok","availability":["RUNTIME"]},{"variable":"TIKTOK_ADS_OAUTH_REDIRECT_URI","value":"https://markaes