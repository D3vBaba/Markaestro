ersions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985483---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"a802468363fb11e85fcdc2af1ee131a4817555bb","hash":"a802468363fb11e85fcdc2af1ee131a4817555bb","commitMessage":"feat(meta): support two connected Facebook accounts with Pages kept apart\n\nThe Meta app-user credential was a single workspace document keyed by\nprovider, so connecting a second Facebook account overwrote the first.\nWorse, that one credential was overlaid onto every Page connection when\nread — so the second account's user token and metaUserId were handed to\nthe first account's Pages, and the picker could only ever see the most\nrecently connected account's Pages.\n\nMeta credentials are now keyed by the authorizing account\n(`meta:{metaUserId}`) exactly like Pinterest and LinkedIn, so a second\nlogin adds a credential. Every Page connection records the account that\ngranted it, and the credential overlay now matches on that key: a Page is\nonly ever paired with the account that owns it. A Page linked before\naccounts were stamped keeps its own stored tokens rather than being\nguessed at, unless exactly one account exists.\n\nOwnership is enforced across the flows: the Page picker enumerates each\nconnected account and labels whose Pages are whose, linking uses the\ncredential that actually returned the Page, the reauthorization sync\nskips Pages owned by a different account, and a workspace-level Meta\ndisconnect takes an `accountId` so revoking one account leaves the\nother's Pages connected.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/a802468363fb11e85fcdc2af1ee131a4817555bb","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T18:54:49Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/d98baa98-e89b-4eba-a44f-85a92302d95c?project=227206788749","createTime":"2026-08-08T18:55:00.331636138Z","updateTime":"2026-08-08T19:00:24.207835Z","displayName":"build-2026-08-08-004","uid":"2503f8f9-ca2f-44bb-b87c-b32cc09b9530","etag":"4VdvgbzjZ62ltQWpXONfQPNiFyVXgPETJ0K330ye8FM","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-003","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-003","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","avail