rsions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"PINTEREST_CLIENT_ID","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"PINTEREST_CLIENT_SECRET","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_ID","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_SECRET","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_ID","secret":"projects/227206788749/secrets/X_CLIENT_ID/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_SECRET","secret":"projects/227206788749/secrets/X_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"26bfd253c88767f3b21c0c51f36e0e92133d51b6","hash":"26bfd253c88767f3b21c0c51f36e0e92133d51b6","commitMessage":"feat(design): port design system to marketing surface (phase 7)\n\nBrings the Markaestro token system to every public page so marketing,\nauth, and app chrome all read as one system.\n\nMarketingLayout:\n- Paper header with hairline border and 14/16px chrome to match the\n  app shell; nav links at 13px with ink-60 / ink active states.\n- CTA buttons normalized to rounded-lg h-9 13px.\n- Mobile menu sheet on paper background with ink-60 labels.\n- Footer on paper with mk-eyebrow section headers, 13px links on\n  ink-60, 11.5px legal row on ink-40.\n\nLegalLayout:\n- Same paper-on-surface chrome; header + footer on paper with ink-40\n  legal text.\n\nLanding (/):\n- Hero headline rebuilt as 40/56/72px sans semibold with accent\n  keyword and tracked -0.035em; eyebrow pill uses mono 10.5px on\n  accent-soft; CTA buttons rounded-lg 11px.\n- Hero stats grid on 1px rule with paper cells, 28/32px semibold\n  figures in accent.\n- Feature, channel, AI-studio sections grounded on alternating\n  paper/surface layers with hairline borders and mk-eyebrow section\n  labels.\n- CTA section flipped from bg-primary/white to --mk-ink / --mk-paper\n  so the final block reads as ink not brand-blue.\n\nPricing:\n- mk-eyebrow replacements for all text-primary uppercase labels.\n- Headlines 4xl/6xl + 3xl/4xl converted from font-display serif to\n  sans semibold with tight tracking.\n- Pricing cards on rounded-xl bg-card; billing toggle uses mk-ink\n  active pill; \"save 18%\" badge on accent-soft; trial line on mk-pos.\n- Comparison + FAQ sections on paper/surface with mk tokens.\n- CTA flipped to ink/paper.\n\nFeatures:\n- Hero + section headlines on sans semibold; eyebrows mk-ified.\n- Feature illustrator card on surface with accent-soft inner panel.\n- Platform features grid on rounded-xl bg-card.\n- CTA flipped to ink/paper.\n\nContact:\n- Hero + section titles on sans semibold.\n- Channel cards and inner info cards on surface/paper with hairline.\n- FAQ + form cards on rounded-xl; button heights/radii normalized.\n- CTA flipped to ink/paper.\n\nAI-Studio:\n- Hero + section titles on sans semibold; eyebrows mk-ified.\n- Example + use-case cards on bg-card with hairline.\n- CTA flipped to ink/paper.\n\nChannels:\n- Hero + channel + how-it-works + CTA all on mk tokens.\n- Stats grid mirrors landing (accent figures on paper cells).\n- Channel cards: capability column on surface with mk-eyebrow header,\n  connection pill as mono small-caps on panel.\n- How-it-works step glyph now accent-soft rounded-xl mono.\n\nDevelopers/API:\n- Eyebrow mk-ified, headline sans semibold.\n- Method chips (GET/POST/etc.) now mono small-caps on accent-soft.\n- All cURL <pre> blocks flipped to ink bg / paper text so code reads\n  as a real terminal pane in both themes.\n\nPrivacy + Terms:\n- Eyebrow + mono last-updated line, 32/36px sans semibold title.\n- Body typography bumped to 14px ink-80 for readability.\n- Section H2s now 17px semibold with tight tracking.\n\n404:\n- Full redesign: eyebrow + oversized mono 404 in accent, sans semibold\n  headline, rounded-lg h-11 buttons, secondary link rail on ink-60.\n\nCo-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/26bfd253c88767f3b21c0c51f36e0e92133d51b6","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-23T15:19:09Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/0b37b4e5-b88b-4bd8-9fc9-c86b8aa8591d?project=227206788749","createTime":"2026-04-23T15:19:12.461726677Z","updateTime":"2026-04-23T15:23:45.759605Z","displayName":"build-2026-04-23-009","uid":"3f4da2d4-e873-4aae-a056-c8232489d133","etag":"H8TgTb1aur-zLFT6ZFMmUc8dkn3JtQJ_nu9kca0_wSA","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-cen