irebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-3342152114---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"24169b9cb65807ce51966ac95e3f3ad04cf46011","hash":"24169b9cb65807ce51966ac95e3f3ad04cf46011","commitMessage":"Rebuild website brand scan production-grade (logo, colors, description)\n\nThe scan previously used og:image as the logo (it's the social share\ncard), meta theme-color as the only brand color (usually the page\nbackground), and shipped truncated meta descriptions verbatim.\n\nNew pipeline, modeled on Brandfetch/metascraper-class extractors:\n- Logo: ranked candidates (JSON-LD Organization.logo, og:logo/itemprop,\n  header <img> logo hints, apple-touch-icon, manifest icons, favicons,\n  /favicon.ico) — og:image excluded by design. Every candidate is\n  downloaded and validated: sharp decode, >=32px, logo-plausible aspect,\n  HTML-masquerading-as-image rejection (SVG content verified too).\n- Colors: weighted multi-source palette — named CSS brand custom\n  properties from same-origin stylesheets, manifest theme_color, meta\n  theme-color, CSS literal frequency, and quantized logo colors; HSL\n  neutral filtering and hue-distance dedup produce distinct\n  primary/secondary/accent.\n- Name/description: JSON-LD + og:site_name + application-name join the\n  chain; <title> segmentation picks the brand segment; truncation\n  detection (ellipsis, dangling function words) rejects cut-off meta\n  descriptions in favor of intact sources or lead body copy, trimmed to\n  complete sentences.\n- All enrichment fetches SSRF-guarded, size-capped, 4s per-asset\n  timeouts; failures degrade gracefully instead of failing the scan.\n- Honest copy: stepper \"Analyse with AI\" -> \"Analyse brand signals\";\n  onboarding no longer claims AI reads the site.\n\nExtraction logic lives in src/lib/products/scan-extract.ts (pure,\ndeterministic) with 24 unit tests; verified live against revtrakkr.com.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/24169b9cb65807ce51966ac95e3f3ad04cf46011","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-07-10T07:28:16Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/35dff9c9-cc09-415e-9810-d707f7bb62ef?project=227206788749","createTime":"2026-07-10T07:28:18.898271585Z","updateTime":"2026-07-10T07:33:02.371087Z","displayName":"build-2026-07-10-003","uid":"d9896c2e-58ee-446a-94c7-581eda7cee74","etag":"rJ_g67I6db7Uga6U0-lm5idtBTrc3ML_9QvCbrlhhOc","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-07-10-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-07-10-002","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variab