arkaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"bfc57a3fecbb1ca0a63b3f9c04a726b5a1faf60f","hash":"bfc57a3fecbb1ca0a63b3f9c04a726b5a1faf60f","commitMessage":"feat(publishing): remove Meta FB↔IG linking fan-out; add dedicated Threads path\n\nEach social channel is now its own dedicated publishing path. Linking a Meta\nconnection no longer auto-co-publishes a single post to both Facebook and\nInstagram.\n\n- publisher.ts: removed resolveMetaChannels; publishPostMultiChannel publishes\n  ONLY the requested channel. Explicit multi-channel posts from the composer\n  (targetChannels → publishExplicitChannels) are unchanged — users can still\n  deliberately pick multiple channels.\n- products.ts: Meta destinations no longer advertise willAlsoPublishTo; added\n  buildThreadsDestinations and wired it into listPublicProductDestinations\n  (Threads was previously missing from product destinations entirely). The\n  Threads adapter is already registered, so this completes an end-to-end path.\n- docs + /developers/api: each channel is its own destination, no fan-out;\n  Threads now exposed.\n- tests updated; full suite 116/116.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/bfc57a3fecbb1ca0a63b3f9c04a726b5a1faf60f","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-06-15T22:48:54Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/05de6487-1ef5-440e-a116-9fc24313a6dc?project=227206788749","createTime":"2026-06-15T22:48:57.278372590Z","updateTime":"2026-06-15T22:52:39.998545Z","displayName":"build-2026-06-15-013","uid":"8b672a52-e22f-4e90-8489-ddba999cc8cd","etag":"KlXLabGeD63i2mJYoDcP9CF8k9_P5d4e5972Y-lrAuQ","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/