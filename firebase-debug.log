":"apphosting.yaml"},{"variable":"PINTEREST_CLIENT_SECRET","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_PROFILE_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_PROFILE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_PROFILE_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_PROFILE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-3334189411---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"a3139322ebe5251e1519771d0f59c97210c0eccd","hash":"a3139322ebe5251e1519771d0f59c97210c0eccd","commitMessage":"fix(tiktok): stop corrupting post ids past Number.MAX_SAFE_INTEGER\n\nTikTok's video/post ids are 19-digit snowflake integers, well past\nNumber.MAX_SAFE_INTEGER (~16 digits). TikTok sends them as bare JSON\nnumbers, so every res.json() call on a response containing one was\nsilently rounding the low digits via IEEE-754 double precision loss.\nVerified against a real account: the status-fetch response's\npublicaly_available_post_id consistently diverged from the same\nvideo's id in video/list, always in the last 3-4 digits.\n\nThis explains why TikTok analytics stayed empty even after the\ninbox re-poll fix landed: the id we stored was already wrong by the\ntime we tried to fetch metrics with it, and separately,\nfetchTikTokMetrics's own video/query lookup compared TikTok's\n(corrupted) returned id against our stored id and could never match.\n\nAlso revealed by the same investigation: TikTok's `status` field\nnever transitions to PUBLISH_COMPLETE for content a creator finishes\nposting natively from their TikTok inbox — confirmed against posts\nthe account owner says are already live, still reporting\nSEND_TO_USER_INBOX indefinitely. publiclyAvailablePostId showing up\nat all (cross-checked against video/list, which only lists truly\npublic videos) is the only reliable \"it's live\" signal for that flow.\n\nFixes:\n- fetchTikTokPublishStatus reads the raw response text and extracts\n  publiclyAvailablePostId via regex before JSON.parse can round it.\n- listTikTokVideos does the same per-video, zipped back by array order.\n- fetchTikTokMetrics stops re-matching video/query's (corrupted) id\n  against our stored id and just trusts the server-side video_ids\n  filter — TikTok won't return a video we didn't ask for.\n- pollTikTokPublishForPost now treats a live publicPostId as\n  equivalent to PUBLISH_COMPLETE even while status still says\n  SEND_TO_USER_INBOX, so posts the creator already finished get\n  correctly promoted to 'published' on the next re-poll.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01F762Pk8pUwVRx68P3doiNN","uri":"https://github.com/D3vBaba/Markaestro/commit/a3139322ebe5251e1519771d0f59c97210c0eccd","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-09T17:49:24Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/9019bc82-b081-4e4d-9b5b-a24603e1340d?project=227206788749","createTime":"2026-08-09T17:49:26.264500622Z","updateTime":"2026-08-09T17:55:14.082888Z","displayName":"build-2026-08-09-009","uid":"ee415018-5884-4080-a6db-1e569443a96a","etag":"BnMpVD0qnD78Im95wrhFIAnhbYqb4KFWLMiSvqdIQyY","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-09-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-09-002","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availabil