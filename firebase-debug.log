e08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-3334189421---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"94957d67d698ab12322970253bdcdb6e11d6730f","hash":"94957d67d698ab12322970253bdcdb6e11d6730f","commitMessage":"fix(tiktok): add missing composite index, isolate the two poll queries\n\nThe action-required re-poll query added in 9e096c6 needs a\n(status, actionRequiredAt) composite index that didn't exist —\nevery tiktok-poll cron tick (runs every minute) was throwing\nFAILED_PRECONDITION and, because both queries shared one\nunguarded Promise.all, taking the pre-existing 'publishing'-status\npoll down with it. Caught within minutes of deploy via Cloud Logging.\n\nAdds the index to firestore.indexes.json (deployed separately via\nfirebase deploy --only firestore:indexes so it starts building\nimmediately) and isolates each query behind its own .catch so one\nquery failing — index still building, transient error, whatever —\ncan never block the other from running.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01F762Pk8pUwVRx68P3doiNN","uri":"https://github.com/D3vBaba/Markaestro/commit/94957d67d698ab12322970253bdcdb6e11d6730f","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-0