databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"95445f1b2ce3c883ef7e59de799a0b900d89ca21","hash":"95445f1b2ce3c883ef7e59de799a0b900d89ca21","commitMessage":"fix: character models not appearing due to missing Firestore composite index\n\nThe listActiveCharacterModels query used .where('isActive', '==', true).orderBy('name'),\nwhich requires a composite index that didn't exist. The query threw, the API returned 500,\nand the picker silently showed \"no models\" instead of surfacing the error.\n\nFix: drop .orderBy() from Firestore and sort by name in memory instead.\nAlso add a fetchError state to the picker so API failures show a real error message.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/95445f1b2ce3c883ef7e59de799a0b900d89ca21","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-11T06:39:27Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/acada520-f08d-492c-abf9-b0386f93c06c?project=227206788749","createTime":"2026-04-11T06:39:33.342238849Z","updateTime":"2026-04-11T06:42:55.803309Z","displayName":"build-2026-04-11-003","uid":"e9c274f3-f41e-41a2-b139-6e6194b490c9","etag":"EuMg2Pq2jm6LrORMeo5gSNNMcehdxb2inm2udmoCmYU","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-11-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-11-002","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":