 Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-03-25T01:58:25Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/e71c77cd-899d-49c3-9612-c127ba6fbc58?project=227206788749","createTime":"2026-03-25T01:58:26.962638962Z","updateTime":"2026-05-22T22:41:27.408632Z","displayName":"build-2026-03-25-002","uid":"147a576e-2618-4ec3-8018-cb94707c9c88","etag":"c_20upzKCc1hvBRZkNRtjbyKrXT0dxihUgVp7_r6-6c","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-07-02-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-07-02-001","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN","value":"https://app.markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_MARKETING_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"APP_DOMAIN_SPLIT