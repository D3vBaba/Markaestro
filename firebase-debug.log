ojects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_ID","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_SECRET","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_ID","secret":"projects/227206788749/secrets/X_CLIENT_ID/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_SECRET","secret":"projects/227206788749/secrets/X_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"1f0abead828c8b6a67d0843ec3174f47cc6264bb","hash":"1f0abead828c8b6a67d0843ec3174f47cc6264bb","commitMessage":"feat(public-api): typed per-channel settings + batch post creation\n\nMatch Postiz on two integrator gaps:\n\n1. Platform-specific settings via discriminated-union `settings` on\n   POST /api/public/v1/posts (`__type` matches the channel). TikTok:\n   privacy/comments/duet/stitch toggles + photoCoverIndex. Instagram:\n   postType (feed/reel/story), collaborators, per-media altText.\n   YouTube: title/description/tags/categoryId/privacyStatus/madeForKids\n   /thumbnailUrl. Each adapter narrows settings via a type guard and\n   wires only the fields its API actually supports today. TikTok\n   Direct Post fields are accepted and logged but not yet honored\n   (MEDIA_UPLOAD inbox flow doesn't accept them).\n\n2. Batch post creation: POST /api/public/v1/posts accepts either a\n   single post object or `{posts: [...]}` (1–25 items). Each item is\n   created sequentially and the response carries per-item ok/error.\n   Idempotency-Key covers the whole batch.\n\nAlso drafts the OAuth2 server plan in docs/plans/oauth2-server.md\ncovering app registration, authorization code + PKCE, refresh\nrotation, the seven product decisions, and a phased rollout.\n\n17 new tests cover settings schema, channel-mismatch validation,\ntype guards, and batch shape.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/1f0abead828c8b6a67d0843ec3174f47cc6264bb","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-05-14T06:42:10Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/6831ffce-a278-4aef-927f-e182e6fa4e05?project=227206788749","createTime":"2026-05-14T06:42:13.829858014Z","updateTime":"2026-05-14T06:45:56.471181Z","displayName":"build-2026-05-14-001","uid":"f1e80fb3-ac02-40c6-8ea1-d909738ee21e","etag":"oOGbf3AhfgatqvZQs7blAcM0lNLT4P6WblxvxOQCsGs","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-010","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-010","config":{"runConfig":{"cpu