"BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1257647256---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"ccb1fa46963a0eb17e98b9dd47cdc911b2c07968","hash":"ccb1fa46963a0eb17e98b9dd47cdc911b2c07968","commitMessage":"feat(api): refuse API keys that are not bound to a product\n\nBinding was enforced when minting a key but not when using one, so keys\nissued before the requirement carried no productId and authenticated\nworkspace-wide — reaching every brand in the workspace.\n\nrequirePublicApiContext now refuses them with 403\nAPI_KEY_NOT_BOUND_TO_PRODUCT and a message pointing at Settings → API.\nApplies to both the Public and Connect APIs, which share this entry\npoint. PublicApiContext.productId becomes non-optional, since an\nauthenticated key is now always bound.\n\nBREAKING for unbound keys: 6 of the 10 keys in production have no\nproductId field and will start receiving 403 (DripCheckr Automation,\nSKYYN AUTOMATION, DripCheckr New Pipeline, SlideSmith, EyeCash Posting,\nSkyyn API Key). Shipping this deliberately — those keys are being\ndeleted and reissued, and a reissued key is bound to one brand. An\nintegration that posts for several brands needs one key per brand.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/ccb1fa46963a0eb17e98b9dd47cdc911b2c07968","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-05T22:13:52Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/eabf39a7-d6e0-4db1-9a67-4d4f1676c18f?project=227206788749","createTime":"2026-08-05T22:13:58.260414649Z","updateTime":"2026-08-05T22:18:11.380163Z","displayName":"build-2026-08-05-006","uid":"bf9ddf50-e4ec-442e-812b-1ecfa7d9ea84","etag":"qjux5KzH58zJprmdbkJQPHOsL964CvOhhrtau_CH9Js","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-05-007","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-05-007","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN","va