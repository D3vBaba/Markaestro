nstagram pink, TikTok red)\n- ChannelSelector platform SVG icons with brand-colored active states\n- Campaigns pipeline runs API routes and campaign-runs lib\n- Network security lib and hosting proxy\n- Various OAuth, server-auth, image generation, and publisher improvements\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/b6e60644a852be8e3f63485e61d9c777d2bcded3","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-03T18:22:53Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/dcbc8ce3-25ee-40ca-b82e-4c9affd8dbc4?project=227206788749","createTime":"2026-04-03T18:22:59.168310612Z","updateTime":"2026-05-22T22:41:27.408632Z","displayName":"build-2026-04-03-003","uid":"791cf708-6ab9-4a0c-a822-481c59e94904","etag":"FJ_GclWg7Cu576tYhz4VqYCuXR8CCBmFLLBGDIA3_5A","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-03-004","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-03-004","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":[