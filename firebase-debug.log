sestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1257647261---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"80ebdd4f8f27cee7ed6e0e8e7376e7bdd1124915","hash":"80ebdd4f8f27cee7ed6e0e8e7376e7bdd1124915","commitMessage":"fix(meta): resolve Pages via granular asset grants; keep partial FB metrics\n\nPage discovery: /me/accounts returns nothing for tokens issued through\nFacebook Login for Business, which exposes the selected Pages only as\ngranular permission targets. Every Page lookup (OAuth callback, the page\npicker, and page select) went through its own copy of that one call, so\na user who granted a Page still saw an empty picker. Extract\nfetchMetaManagedPages, which falls back to debug_token granular_scopes\nand resolves each target id individually. Keeps the requested scopes\nunchanged. Callback now also treats a single Page with no access_token\nas \"selection required\" instead of storing an unusable connection.\n\nFacebook metrics: the optional post-fields read (reactions/comments/\nshares) needs pages_read_user_content, which a Page token can lack while\nstill reading /insights. That read failing aborted the whole fetch and\ndiscarded good insights data. Make it best-effort and only fail when\nneither source is readable.\n\nShips lib/pinterest-api.ts as well: the shared OAuth routes above now\nroute Pinterest URLs through it, so it is a build dependency. It\ndefaults to the production origin when PINTEREST_API_ENVIRONMENT is\nunset, so Pinterest behaviour is unchanged by this commit. The rest of\nthe Pinterest work (Sandbox env, CSP, boards:write scope, publishing\nadapter) is deliberately not included.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/80ebdd4f8f27cee7ed6e0e8e7376e7bdd1124915","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-05T21:46:47Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/260a1421-a7b2-49e4-8333-84e283549661?project=227206788749","createTime":"2026-08-05T21:47:33.947810171Z","updateTime":"2026-08-05T21:52:37.597100Z","displayName":"build-2026-08-05-003","uid":"74799fe6-6c1b-413e-8d51-e5d698860c90","etag":"HxoIVjX8jiRoSN2V_xNYC99MXc_HDzRzfDUEOKUcCEk","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-05-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-05-001","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"var