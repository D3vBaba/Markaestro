.\n\nCo-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/a092bcff859667a21c226cd37fc728c33e1ddb16","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-03-26T00:11:57Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/0b6084c8-a59d-485f-a94e-bcfcbd9d23fa?project=227206788749","createTime":"2026-03-26T00:11:59.259088223Z","updateTime":"2026-05-22T22:41:27.408632Z","displayName":"build-2026-03-26-001","uid":"79374eb2-2356-4a5e-9c0a-b79e48cd91f4","etag":"LpsJAWmcR6ZJwxZOk1nRytBKq9CVZy_SQSzC5Uaii28","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-03-26-011","state":"EXPIRED","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-03-26-011","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro-0226220726.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"TIKTOK_OAUTH