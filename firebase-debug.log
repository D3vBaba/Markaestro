cret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_KEY/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"TIKTOK_ADS_CLIENT_SECRET","secret":"projects/227206788749/secrets/TIKTOK_ADS_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"27d738fb27ec0c68156eb67aa9346d5782a8aa0a","hash":"27d738fb27ec0c68156eb67aa9346d5782a8aa0a","commitMessage":"fix(tiktok): publish via upload/inbox (MEDIA_UPLOAD), not Direct Post\n\nThe production TikTok app has video.upload scope approved but not a\nDirect Post audit, so DIRECT_POST was rejected with the generic\n\"content-sharing-guidelines\" error. Switch both photo and video flows\nto the unaudited-safe upload path so content lands as a draft in the\ncreator's TikTok inbox to finalize and post.\n\nPhotos (/v2/post/publish/content/init/):\n  - post_mode: MEDIA_UPLOAD (was DIRECT_POST)\n  - Dropped DIRECT_POST-only fields: privacy_level, disable_comment,\n    auto_add_music. title/description stay as optional hints.\n\nVideos:\n  - Endpoint changed from /v2/post/publish/video/init/ to\n    /v2/post/publish/inbox/video/init/\n  - Dropped post_info entirely (not accepted by the inbox endpoint).\n  - Propagate reviewRequired and nextAction up through the adapter so\n    the post transitions to exported_for_review on completion.\n\nPoll worker:\n  - Handle SEND_TO_USER_INBOX terminal status (was only PUBLISH_COMPLETE\n    and FAILED). Posts that didn't finalize within the adapter's\n    synchronous 12s poll window now transition to exported_for_review\n    with nextAction set, instead of being stuck in 'publishing'.\n\nPULL_FROM_URL still requires a verified domain on TikTok's side; that's\na dashboard action separate from this commit.\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/27d738fb27ec0c68156eb67aa9346d5782a8aa0a","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-16T08:03:15Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/e969c5b4-f913-4e37-a75d-63258131f7f5?project=227206788749","createTime":"2026-04-16T08:03:18.070787461Z","updateTime":"2026-04-16T08:07:31.124563Z","displayName":"build-2026-04-16-004","uid":"46d177f4-bba2-4bf8-8992-a59512e250bc","etag":"mqswhVkmoecCi8CoFDYeAI4GZORWw3GP_wQ3CItWxi0","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-16-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-16-005","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726