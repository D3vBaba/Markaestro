 the write path. Log each entry's typeof\n(never its value) to see the actual shape without another guess-and-log\ncycle.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/634a36816a14ba178a05855c27cc454f4aa69fd9","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-12T01:27:13Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/00db6e0a-cc9e-4227-ba65-c82d669a51d7?project=227206788749","createTime":"2026-08-12T01:27:16.265433422Z","updateTime":"2026-08-12T01:33:10.543501Z","displayName":"build-2026-08-12-002","uid":"437de192-3004-4bd1-9a81-b26a6c7ae9ca","etag":"Hpk3Z6gpJ_X3dQzZWqZTXTBQTcgROU-ngKTPziZsJxo","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-12-003","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-12-003","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"htt