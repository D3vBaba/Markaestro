"availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"commit":"2630453627ba6bb4d3b1249269a6a8d791da83b5","displayName":"2630453627ba6bb4d3b1249269a6a8d791da83b5","hash":"2630453627ba6bb4d3b1249269a6a8d791da83b5","commitMessage":"feat(settings): product-centric Integrations tab — link/unlink channels per product\n\nReplaces the single workspace-level Meta card with a product-first view: each\nproduct lists its channels (Meta, TikTok, Threads) with Link/Unlink, scoped to\nthat product. Fits the one-channel-per-product model.\n\n- New IntegrationsTab: lists products (/api/products), per-product connection\n  status via /api/integrations?productIds=, Link runs the product-scoped OAuth\n  (authorize?productId=&returnTo=/settings?tab=integrations), Unlink calls\n  disconnect with { productId }.\n- Meta page picker: when a Meta connection exposes multiple Facebook Pages, a\n  dialog lets the user pick the Page (and its linked Instagram) for that product\n  (/api/oauth/pages/meta + /select).\n- OAuth callback now honors returnTo for per-product connects (returns to the\n  Settings → Integrations tab instead of always /products).\n- All OAuth/connection backend already supported productId scoping; this is a\n  UI build plus the one callback returnTo tweak.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/2630453627ba6bb4d3b1249269a6a8d791da83b5","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-06-16T00:36:07Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/40ef6b4a-675e-4ad1-a4c3-facbf94fb51f?project=227206788749","createTime":"2026-06-16T00:36:34.312836474Z","updateTime":"2026-06-16T00:41:08.076533Z","labels":{"deployment-tool":"cli-firebase"},"uid":"b5540ac7-ac7b-4188-95bc-e19e466912e1","etag":"Z0Ea3QAAKQZf3J3wL7NqxMgb64DNkbAt13BvhWmFJEo","reconciling":false},{"name":"projects/ma