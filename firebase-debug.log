LD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1257647257---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"224eab8966a9033ba542ed74f4a0c24e13d3c937","hash":"224eab8966a9033ba542ed74f4a0c24e13d3c937","commitMessage":"fix(posts): load every post and order newest date first\n\nThe tabs fetched /api/posts?status=... with no limit, taking the schema\ndefault of 50, then paginated those 50 client-side. The Scheduled tab was\nshowing 50 of 349 posts — the other 299 were unreachable by any amount of\npaging. Drafts fired three such queries, so it capped at 50 per status\ngroup.\n\nRaise the paginationSchema ceiling from 200 to 1000 and have each tab ask\nfor the full set, so pagination now walks every post. GET /api/posts\nreports truncated when a result fills the limit exactly, so a list can\nnever present itself as complete when it isn't.\n\nOrdering keyed off createdAt (Drafts) or nothing at all (Scheduled,\nPublished, which rendered in Firestore's return order). A post's date\nlives in a different field depending on its state, so sortPostsByNewestDate\nkeys off publishedAt, else scheduledAt, else createdAt: page 1 holds the\nnewest dates and paging walks into older ones. Undated posts sort last\nrather than jumping to the front on a 0 timestamp. Sorting happens at\nrender rather than at fetch so an optimistic reschedule re-orders\nimmediately.\n\nAgainst the current workspace: Scheduled 50 -> 349 posts (59 pages),\nPublished 50 -> 65 (11 pages), Drafts unchanged at 35.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/224eab8966a9033ba542ed74f4a0c24e13d3c937","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-05T22:51:34Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/b33b974e-8741-4268-aa1c-26ef21fed55d?project=227206788749","createTime":"2026-08-05T22:51:42.162136866Z","updateTime":"2026-08-05T22:56:45.819758Z","displayName":"build-2026-08-05-007","uid":"c6aeaacb-b159-4121-a1f9-d1da28fbd610","etag":"JDPxAyNFJaw8uli_BuNeOFMx43FgtR8_xvprPStm3Yc","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-05-004","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-05-004","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","