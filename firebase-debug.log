 tile\n  blurred on the posting page. Provider order now matches the publish\n  path (instagram before meta); subsumes the LinkedIn-only special case\n- ChannelSelector: refetch channel statuses on window focus so accounts\n  linked in the OAuth tab light up without a page reload\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/75b5afb43e133c3d4101d77b9bd59d1bc85da70a","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-07-02T01:32:50Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/53665565-facf-4ac2-9967-8a9df195d19d?project=227206788749","createTime":"2026-07-02T01:32:53.111635070Z","updateTime":"2026-07-02T01:38:16.788126Z","displayName":"build-2026-07-02-001","uid":"2fc73102-2cf2-44ff-9437-5a00b203d4f6","etag":"s0ASoObK6A2rDUASEfip3D0OgDtT2ohEEmuIjitwmJE","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-07-02-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-07-02-002","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD