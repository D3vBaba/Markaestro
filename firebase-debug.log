ost.updatedAt when measuring how\nlong a post has been stuck in PROCESSING_UPLOAD/PROCESSING_DOWNLOAD —\nbut every poll tick refreshes updatedAt, so the 70-min give-up window\nreset every minute and posts could sit in PROCESSING_UPLOAD indefinitely\n(observed in prod: 4+ hours). Set publishStartedAt once at publish so\nthe sweeper has a stable reference point.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/0549ae6582dbedac500b06c490bdd108176d1413","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-05-04T21:37:24Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/7b9a4497-ff97-4581-a319-a8cb08ecf9cd?project=227206788749","createTime":"2026-05-04T21:37:27.815174713Z","updateTime":"2026-05-04T21:41:00.349416Z","displayName":"build-2026-05-04-006","uid":"baf67aa2-3675-4215-82c0-97433a44d320","etag":"7mKqtCPnrsKCqY3Rhws47fNafu_k6iD-P1HSnNPGopA","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-17-010","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-17-010","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable