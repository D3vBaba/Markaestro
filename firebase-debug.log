-11T23:24:03Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/6a9fd67f-fabe-40fb-8fc6-6a3eb83394f7?project=227206788749","createTime":"2026-08-11T23:24:23.661967903Z","updateTime":"2026-08-11T23:30:17.996695Z","displayName":"build-2026-08-11-001","uid":"f69e8f7b-4410-4780-95f0-74f89211f11c","etag":"c_nAH1kpol8jiv5-3ENksDEkLVqA2tN1Bfn1VJjAs68","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-18-008","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-18-008","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN","value":"https://app.markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_MARKETING_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"APP_DOMAIN_SPLIT_ENABLED","value":"1","availability":["RUNTIME"]},{"variable":"TIKTOK_OAUTH_REDIREC