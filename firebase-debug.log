 use user token for Meta ad accounts + workspace fallback\n\n- ad-accounts route was calling resolveAccessToken() which prefers the\n  Facebook page token; page tokens cannot list ad accounts via the\n  Marketing API — must use the raw user access token\n- add workspace-level fallback so ad accounts are found even when the\n  campaign has no productId or the connection was created at workspace level\n- surface API error messages as toasts in the campaign edit sheet so\n  the user can see why ad accounts are empty (e.g. missing app permissions)\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/e3f06038438ce876cd95f584155de2f1931f1e13","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-03-13T05:29:35Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/5fa662d6-72cd-41d8-b227-e9949edbac81?project=227206788749","createTime":"2026-03-13T05:29:39.965248037Z","updateTime":"2026-05-22T22:41:27.408632Z","displayName":"build-2026-03-13-003","uid":"02a30a74-0841-481e-bea7-4cec22cba538","etag":"-VyJWyDNDNw_FHlWMJaMPfgLpoQJCDjD10MHTMWBbG4","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-03-13-001","state":"EXPIRED","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-03-13-001","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro-0226220726.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"mark