; default archived:false on create\n- settings API Access tab: toggle, Archive/Unarchive buttons, Archived badge\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/1421ecd7ec8c99fe272922acccbe7436c69791f8","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-06-15T20:31:54Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/c398101b-32ac-4026-adb2-ed37d4c84cce?project=227206788749","createTime":"2026-06-15T20:31:56.867194451Z","updateTime":"2026-06-15T20:37:00.603158Z","displayName":"build-2026-06-15-006","uid":"487b0b96-50ed-4a5e-8991-d46c2c27b8b5","etag":"uzgMGZQKBUtL2nIfuIFDg_QIstu7aYEbKTR3RI2LdHE","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-15-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-15-005","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":