deo campaigns show a native video player with controls\n- Ad headline and primary text shown in a copy block below the media\n- When no media: ad copy shown inline with status badge in the header\n- Campaign dates (Started / Ends / Ended) shown in the subheader\n- Full metrics grid moved inside the dialog (all rows: core, conversion,\n  reach/video, revenue — same as before)\n- AI insights follow below the metrics as before\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/ce916969997865951eb9e5fbf7608b834874f304","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-07T00:45:05Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/3308e2bc-f796-435e-ac87-1092c736a45b?project=227206788749","createTime":"2026-04-07T00:45:07.344703654Z","updateTime":"2026-04-07T00:50:21.153391Z","displayName":"build-2026-04-07-003","uid":"41c5fbff-a2b0-492d-8104-43310a6b4f62","etag":"4Gd5T1-_BKnYGxU6PlITkeLnHBnZCyMax7ONdZJ45JM","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-15-010","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-15-010","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"22720678