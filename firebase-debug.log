in":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-3334189420---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"9e096c63f97b54062fb5be5cff6a8d56d9eeb6e1","hash":"9e096c63f97b54062fb5be5cff6a8d56d9eeb6e1","commitMessage":"fix(tiktok): re-poll inbox hand-offs so posts don't get stuck forever\n\nTikTok's Content Posting API can't publish on our behalf: a video lands\nin the creator's TikTok inbox (SEND_TO_USER_INBOX) and they have to open\nthe app and finish posting it themselves. Nothing pings us back when\nthey do, and pollPendingTikTokPublishes only re-checked posts still in\nstatus='publishing' — so once a post reached platform_action_required,\nit was never polled again, even if the creator went ahead and finished\nit on TikTok's side minutes later.\n\nTwo consequences: the post's externalId stayed as TikTok's internal\npublish_id (never swapped for the real numeric video ID), and status\nnever advanced to 'published' — which analytics aggregation requires\n(recomputeDailyAggregates filters on status=='published'). Concretely,\nof 253 TikTok posts in one workspace, only 6 ever reached 'published',\nand every one of those 6 has no metrics; two fail outright with\n\"Video ID ... is invalid. Must be an integer!\" because the stored\nexternalId was never the real video ID to begin with.\n\nNow the batch poller also re-polls platform_action_required TikTok\nposts, bounded to a 10-day window past TikTok's own ~7-day inbox draft\nexpiry (actionRequiredAt is held fixed across re-polls rather than\nrefreshed each tick, so the window actually closes instead of resetting\nindefinitely). A post the creator finishes posting is detected on the\nnext poll, flips to 'published' with the real video ID, and becomes\neligible for metrics and analytics like any other published post.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01F762Pk8pUwVRx68P3doiNN","uri":"https://github.com/D3vBaba/Markaestro/commit/9e096c63f97b54062fb5be5cff6a8d56d9eeb6e1","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-09T17:03:28Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/fbcf3ce4-9dea-4ee4-8b8a-dfaac14d4e9f?project=227206788749","createTime":"2026-08-09T17:03:31.153977545Z","updateTime":"2026-08-09T17:08:34.805540Z","displayName":"build-2026-08-09-006","uid":"7b1445b8-3fed-4e98-ab9d-da767c3d0d9d","etag":"sKermupnHHz7PbYAl_kAwfLZ_0wHB-HFNlKd2ipJCpw","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-09-007","state":"READY","image":"us-central1-docker.pkg.dev/markae