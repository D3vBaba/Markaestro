le":"PINTEREST_CLIENT_SECRET","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_ID","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_SECRET","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_ID","secret":"projects/227206788749/secrets/X_CLIENT_ID/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_SECRET","secret":"projects/227206788749/secrets/X_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"32c6714119f1edd93c5a924039ef83a96daef2f2","hash":"32c6714119f1edd93c5a924039ef83a96daef2f2","commitMessage":"feat(design): port design system to auth + onboarding surfaces (phase 5)\n\nBrings the Markaestro design tokens, typography, and pill helper to the\nremaining full-bleed surfaces that every user hits.\n\nLogin (/login):\n- Dropped the marketing-layout card shadow and serif display heading.\n- Left panel: mk-eyebrow + 40px semibold headline with accent keyword,\n  bullet items on 6px accent dots and mk-ink 13.5/12.5 body scale.\n- Right panel: hairline card with mk-eyebrow + 24px semibold title +\n  13px subtitle, inline segmented sign-in/sign-up toggle on mk-panel\n  with paper-fill active state.\n- Inputs 11px rounded-lg, primary button h-11 rounded-lg, OAuth divider\n  switched to mono small-caps \"OR CONTINUE WITH\", Facebook icon sources\n  --mk-ch-facebook.\n- Error/success banners use pillStyle(neg/pos); the old rose/emerald\n  tailwind boxes are gone.\n- Terms + Privacy footnote added.\n\nAuth action (/auth/action):\n- Same hairline-card treatment for reset / verify / confirm flows.\n- Titles gain mk-eyebrow + 24px semibold, 13px descriptions.\n- Error + success banners on pillStyle tokens; CTA links on --mk-accent.\n\nOnboarding (/onboarding):\n- Header: paper background, 14/16px chrome, inline 15px wordmark,\n  mono \"STEP X / Y\" counter, progress bar now a 1px hairline that\n  fills with accent.\n- Section eyebrows converted from text-primary uppercase to mk-eyebrow\n  (mono small-caps on --mk-ink-60).\n- Section titles switched from font-display (Instrument Serif) to\n  sans semibold at 28/34px with -0.03em tracking for desktop weight.\n- SelectionTile rewritten with hairline border (paper bg, panel fill\n  when selected, ink border on selection) and ink radio/checkbox\n  markers instead of primary-tinted ones.\n- Preview-ready success glyph now pos-tinted via color-mix instead of\n  emerald-50 / emerald-600 pastels.\n\nOnboarding success (/onboarding/success):\n- Full rewrite on surface / paper tokens: minimal header, pos-tinted\n  check badge with color-mix, mk-eyebrow + 28/32px semibold headline,\n  13.5px body, accent-filled 1px progress bar pacing the redirect.\n\nCo-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>","