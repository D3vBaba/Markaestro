view in\nMarkaestro (deliveryMode=user_review). The Publish button in the UI\nnow forces deliveryMode=direct_publish, routes through the TikTok\nadapter, and pushes the asset to the user's TikTok inbox via\nPULL_FROM_URL. exported_for_review posts are now (re)publishable so a\nstaged draft can be pushed to TikTok on demand. DraftsTab and\nScheduledTab show a per-post loading spinner and a sonner progress\ntoast that resolves with success/error copy reflecting the inbox flow.\n\nCo-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/6fc2cda899dee83fc9672f880c7b016e82f3b787","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-23T01:58:39Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/c30ad059-495a-4b06-a5cc-57829dfbe4a8?project=227206788749","createTime":"2026-04-23T01:58:45.060277525Z","updateTime":"2026-04-23T02:03:28.423691Z","displayName":"build-2026-04-23-001","uid":"0b9e2c71-2926-4e83-b3cd-6ec00467ee2a","etag":"14_0OegPUDstCwSVbl_pscknlQq7UhmGfg7iBuISGeQ","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-23-006","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-23-006","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10,"minInstances":1},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"v