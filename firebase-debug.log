["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"d8718d8857151cbac74bf8f983c45162332ef7f2","hash":"d8718d8857151cbac74bf8f983c45162332ef7f2","commitMessage":"feat(tiktok): gate the Direct Post composer behind a flag\n\nTikTok forces every post from an unaudited client to SELF_ONLY, so\nshipping the option now would offer creators a public post that silently\nlands as private. NEXT_PUBLIC_TIKTOK_DIRECT_POST=1 opts in; production\nsets nothing, so the mode picker and compliance panel never render and\nevery TikTok post takes the inbox hand-off exactly as before.\n\nOnly the composer UI is gated. The publish path and the documented\n`settings.postMode` public API field are untouched, so the flow stays\ntestable locally and via the API ahead of the audit.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/d8718d8857151cbac74bf8f983c45162332ef7f2","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-14T09:54:21Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/37476e0d-8507-4680-bc52-d84d1a0988e9?project=227206788749","createTime":"2026-08-14T09:54:24.737003720Z","updateTime":"2026-08-14T10:00:18.935413Z","displayName":"build-2026-08-14-002","uid":"fd59c9b4-fd16-4c07-8e57-79c9529e0685","etag":"DN8YduoYmoiT4ZA4y2ziTgG6PT0wRJpY43DPkHjr18Y","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-06-22-001","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-06-22-001","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","val