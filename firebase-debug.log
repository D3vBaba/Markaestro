264) → FILE_UPLOAD.\nAdds ~5–15s per upload, eliminates the entire failure class.\n\nExtract ffmpeg pipeline to src/lib/media/tiktok-transcode.ts so unit\ntests can mock it without an ffmpeg binary on the test runner.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/da92b46f7afef54a8f5b7db3f6858e9b77ad29a1","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-05-04T16:46:10Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/bc79c369-f536-40d2-865d-273f9e67457c?project=227206788749","createTime":"2026-05-04T16:46:12.889981325Z","updateTime":"2026-05-04T16:51:06.428503Z","displayName":"build-2026-05-04-004","uid":"b112bd39-5562-43bd-87c1-200f5d760d8f","etag":"FMMHrC1xgLdmv8OvESGGkekgLYmaPzqHRTwJ2HCEBG0","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-05-04-005","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-05-04-005","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_