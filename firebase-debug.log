basestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2382985484---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"a2f6cd3d01f29095599c7ab9cf7c268fb1b2a730","hash":"a2f6cd3d01f29095599c7ab9cf7c268fb1b2a730","commitMessage":"fix(meta): never revoke Pages on reauthorization; unlink one Page at a time\n\nReconnecting one brand disconnected the others. Facebook Login for\nBusiness asks which Pages to grant on every authorization, so a Page\nmissing from *this* grant usually means the user did not tick it again —\nnot that access was withdrawn. syncGrantedMetaProductConnections walks\nevery brand in the workspace, so treating absence as removal marked all\nthe other brands \"reconnect\". Page tokens are long-lived and independent\nof the user token that issued them, so those Pages were still perfectly\nable to publish.\n\nThe sync no longer revokes at all. It refreshes the Pages the grant\ncovers and leaves everything else untouched; a partial read also no\nlonger overwrites the cached Page list the picker shows. Genuine loss of\naccess still surfaces where it is unambiguous — a failing publish or\ntoken refresh marks the connection, and Meta's deauthorize/data-deletion\nwebhooks remove connections outright.\n\nReconnecting also should never have required unlinking. Both the brand\nsheet and Settings now offer Reconnect, which re-runs OAuth in place, and\nSettings lists each linked Page with its own Unlink so a single Page can\nbe swapped without dropping the rest. The destructive action is labelled\nwith how many accounts it removes, and its confirmation says the scope is\nthis brand only.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/a2f6cd3d01f29095599c7ab9cf7c268fb1b2a730","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-08T18:43:04Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/106d6b07-523d-4d0f-aea9-5056d6f5c205?project=227206788749","createTime":"2026-08-08T18:43:14.355164481Z","updateTime":"2026-08-08T18:48:38.186423Z","displayName":"build-2026-08-08-003","uid":"a4df0c03-0cc6-48c1-8f0d-4240b5217450","etag":"QLcRk15zdUrg6DherKTWrv-olbguYFezTgjfT4ws3lk","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-08-002","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-08-08-002","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_URL","value":"https://markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"OAUTH_BASE_URL","value":"https://markaestro.com","availability":["RUNTIME"]},{"variable":"NEXT_PUBLIC_APP_ORIGIN