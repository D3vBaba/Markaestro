L\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"2b6ce2fca55090b7d739a8e67044e65bcbdd1058","hash":"2b6ce2fca55090b7d739a8e67044e65bcbdd1058","commitMessage":"fix(tiktok): self-heal errored connections and refresh tokens at publish time\n\nTwo TikTok token-refresh fixes:\n\n1. Self-healing cron: the refresh cron skipped any connection whose status\n   wasn't 'connected', permanently abandoning connections after a single\n   transient failure dropped them to 'error'. Skip only 'revoked'\n   connections instead, so 'error' connections are retried. The\n   MAX_REFRESH_FAILURES counter already bounds retry attempts.\n\n2. Publish-time refresh: add refreshConnectionToken() for on-demand refresh\n   and use it in publishPost — proactively refresh a TikTok token that is\n   expired or within 5 minutes of expiry before publishing, and reactively\n   refresh-and-retry once if TikTok rejects the token with\n   access_token_invalid.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/2b6ce2fca55090b7d739a8e67044e65bcbdd1058","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-06-04T00:13:29Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/53552aac-799f-49a4-9c73-7314401df930?project=227206788749","createTime":"2026-06-04T00:13:47.879435272Z","updateTime":"2026-06-04T00:18:21.022076Z","displayName