,{"variable":"PINTEREST_CLIENT_ID","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"PINTEREST_CLIENT_SECRET","secret":"projects/227206788749/secrets/PINTEREST_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_ID","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"YOUTUBE_CLIENT_SECRET","secret":"projects/227206788749/secrets/YOUTUBE_CLIENT_SECRET/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_ID","secret":"projects/227206788749/secrets/X_CLIENT_ID/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"X_CLIENT_SECRET","secret":"projects/227206788749/secrets/X_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"0ca5358431c2034e7321c163585fe3d511987137","hash":"0ca5358431c2034e7321c163585fe3d511987137","commitMessage":"feat(design): mobile responsive polish + uniform product card heights (phase 4)\n\nMobile responsive pass across every app page that phases 1-3 touched, plus\na uniformity fix for the product grid so cards stay the same height\nregardless of content depth.\n\nHeader:\n- Mobile sheet now mirrors the desktop sidebar exactly: brand, workspace\n  chip (via WorkspaceProvider), nav icons + labels at a 44px-ish tap target,\n  settings row, and the user tile with \"log out\" pinned to the bottom.\n- Inline Markaestro wordmark shown on the header between the menu trigger\n  and the right cluster on mobile/tablet so the bar doesn't read as empty.\n- Avatar tap target bumped to 36px on mobile (32px unchanged on desktop).\n- Search bar width flexes to 260px on md then 320px on lg instead of\n  getting clipped at tablet widths.\n\nPageHeader:\n- Title scales 22→26px, subtitle 13→13.5px at sm so long titles fit on\n  narrow phones.\n- Action cluster now wraps under the title on mobile without pushing\n  secondary buttons off-screen.\n\nDashboard:\n- KPI cards scale: 22px figure, p-3 padding, tighter gaps on mobile.\n  Labels/subtitles truncate.\n- Chart card padding + section-header type scale responsively.\n- \"Posts by channel\" section padding halves on mobile so the channel rows\n  don't hug the edges.\n\nCampaigns list:\n- Rewrote the row layout from a 4-column grid to an icon + flex body. On\n  mobile the status pill now sits beside the title instead of getting\n  squeezed into a third column. Meta and date/delete rows wrap cleanly.\n- Filter tabs gain overflow-x-auto so they never clip at narrow widths.\n\nProducts list:\n- Filter tabs gain overflow-x-auto.\n- ProductCard locked to a fixed 260px height with overflow-hidden and a\n  flex-col layout that pins the connections/date footer to the bottom via\n  mt-auto. Every card is now the same height across web and mobile\n  regardless of whether it has a description, URL, or tag row.\n\nPosts (content):\n- Tab content spacing reduced on mobile (space-y-8 → space-y-5 sm:space-y-6).\n\nAll other in-app surfaces (Calendar, Analytics, Settings, Campaign detail)\nwere already using responsive breakpoints from earlier phases and needed\nno further polish.\n\nCo-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/0ca5358431c2034e7321c163585fe3d511987137","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-04-23T07:54:01Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/dce4f2d0-0051-4d25-827a-a117fce899f7?project=227206788749","createTime":"2026-04-23T07:54:04.174846964Z","updateTime":"2026-04-23T07:58:17.168595Z","displayName":"build-2026-04-23-006","uid":"b66e4337-87e9-46cd-a204-e9f495fe6c0c","etag":"GouIRFepDFEwpiQPO55athvjuFHmmz496hdabQ9rDOQ","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-04-23-007","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-04-23-007","config":{"runConfig":{"cpu":1,"memoryMib":1024,"concurrency":80,"maxInstances":10,"minInstances":1},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availab