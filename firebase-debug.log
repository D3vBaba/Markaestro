riable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-2895340799---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"0295083b3ea3a8badf85307075650de644aee16b","hash":"0295083b3ea3a8badf85307075650de644aee16b","commitMessage":"fix(auth): use marketing apex as Firebase authDomain on app subdomain\n\nsignInWithPopup opens https://<authDomain>/__/auth/handler and the OAuth\nproviders must have that exact URL as an authorized redirect URI. After the\ndomain split, login runs on app.markaestro.com, so resolveAuthDomain()\nreturned app.markaestro.com — which is NOT a provisioned redirect URI, so the\nGoogle/Facebook popup closed immediately.\n\nRoute every markaestro.com host's authDomain through the marketing apex\n(NEXT_PUBLIC_MARKETING_URL): it is same-site with the app subdomain (popup\nkeeps first-party storage) and its /__/auth/handler + provider redirect URIs\nare already provisioned (they served the pre-split app on markaestro.com).\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/0295083b3ea3a8badf85307075650de644aee16b","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-06-14T02:12:46