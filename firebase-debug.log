MMUNITY_CLIENT_ID","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_ID/versions/1","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"LINKEDIN_COMMUNITY_CLIENT_SECRET","secret":"projects/227206788749/secrets/LINKEDIN_COMMUNITY_CLIENT_SECRET/versions/2","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08\",\"appId\":\"1:227206788749:web:dea0c199026903c4cdd4c4\",\"authDomain\":\"markaestro-0226220726.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"227206788749\",\"projectId\":\"markaestro-0226220726\",\"storageBucket\":\"markaestro-0226220726.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"markaestro-227206788749.us-central1.run.app,markaestro-auwks5pljq-uc.a.run.app,t-1257647260---markaestro-auwks5pljq-uc.a.run.app,markaestro--markaestro-0226220726.us-central1.hosted.app","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"081d1a3da98fc715a7a63303c37f687af3da5c81","hash":"081d1a3da98fc715a7a63303c37f687af3da5c81","commitMessage":"feat(brands): filter the calendar by brand, scope the whole Posts page\n\nCalendar: add a brand filter alongside status and channel. Uses a select\nrather than chips since a workspace can have many brands and that row is\nalready dense. Mirrors to ?brand= like the other filters, offers a\n\"No brand\" bucket when some posts have none, and falls back to an\n\"Unknown brand\" option so the control never reads \"All\" while a\n?brand= value is still loading or points at a deleted brand. The\nselected brand's name now shows in the post preview.\n\napplyFilters takes a patch object instead of positional args — a third\nfilter made every call site re-pass the ones it wasn't changing.\n\nPosts page: productId only reached CreateTab and PlatformPostsTab, so\nDrafts/Scheduled/Published listed every post in the workspace regardless\nof the selected brand. Thread it through all of them.\n\nFiltering happens server-side via a new productId param on GET\n/api/posts, not after the fetch: those tabs fetch with a 50-post cap, so\na client-side filter would apply the cap before the brand filter and\nhide a brand's older posts. executeListQuery skips orderBy when filters\nare present, so no new composite index is needed (validate:queries\npasses). Tabs reset to page 1 on brand change.\n\nNote: posts with no productId no longer appear on the Posts page, since\na concrete brand is always selected there. The calendar's \"No brand\"\nfilter is how to find them.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/081d1a3da98fc715a7a63303c37f687af3da5c81","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysa@aethossolutions.com"},"commitTime":"2026-08-05T21:42:35Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/bc71a10a-3513-41ee-8e06-d81efdd8593d?project=227206788749","createTime":"2026-08-05T21:42:42.141429921Z","updateTime":"2026-08-05T21:47:55.888283Z","displayName":"build-2026-08-05-002","uid":"d62724db-9c3e-4fd4-99d1-f5f0f441a558","etag":"mR1kHiwCpFF1xYMRQMEiZnFxQ-y6VcYem-u1k8VxAeo","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-08-05-003","state":"READY","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphostin