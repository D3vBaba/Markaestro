TS.\nVoice is now a free-text description (e.g. \"young female, British accent\")\nwith 6 presets, instead of a fixed voice enum.\n\nTested: submit → IN_PROGRESS → COMPLETED in ~90s with video output.\n\nCo-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>","uri":"https://github.com/D3vBaba/Markaestro/commit/b4bc47502499361d7bc794923f85343d022657e6","author":{"displayName":"Rodney Sama-Ambe","email":"rodneysama-ambe@Rodneys-Mac-mini.local"},"commitTime":"2026-03-19T19:16:12Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/ee508d60-8c6d-4699-8813-a6c6c0cf2e81?project=227206788749","createTime":"2026-03-19T19:16:14.347463691Z","updateTime":"2026-05-22T22:41:27.408632Z","displayName":"build-2026-03-19-012","uid":"6bc9c698-acfd-485a-92de-c65b2426783b","etag":"VC6YtK63c4hzBIgK-mOiFR2D0hltqgIyy9yNIp5qw2g","reconciling":false},{"name":"projects/markaestro-0226220726/locations/us-central1/backends/markaestro/builds/build-2026-03-19-011","state":"EXPIRED","image":"us-central1-docker.pkg.dev/markaestro-0226220726/firebaseapphosting-images/markaestro:build-2026-03-19-011","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":4},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyBSyzoIBbqmk9iBBE2qu4fzcw4ib6-Le08","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"markaestro-0226220726.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"markaestro-0226220726","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"markaestro-0226220726.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"227206788749","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:227206788749:web:3b4e8c1b6e9bfeb1cdd4c4","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_P